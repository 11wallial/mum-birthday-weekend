shader_parameter/vignette_start = 0.52
shader_parameter/vignette_strength = 0.55
shader_parameter/shadow_tint = Color(0.055, 0.043, 0.031, 1)

[sub_resource type="PlaceholderTexture2D" id="Tex_none"]

[node name="FilmOverlay" type="CanvasLayer"]
layer = 1

[node name="Rect" type="ColorRect" parent="."]
