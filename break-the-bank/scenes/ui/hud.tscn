[gd_scene load_steps=5 format=3]

; Three gauges top-left, a thin log bottom-left, and a prompt in the middle.
; Everything the world can carry has left this overlay: debt is on the machine's
; monitor and the floor's name is on the wall, so the HUD is down to the numbers
; a player checks between spins.

[ext_resource type="Script" path="res://scripts/presentation/hud.gd" id="1_hud"]

