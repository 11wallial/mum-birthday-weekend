[gd_scene load_steps=9 format=3]

; The machine's geometry is not authored here. MachineFrame builds it in code at
; _ready, because its character comes from a density of rivets, hoses and trims
; that would be unmaintainable as a few hundred hand-placed nodes. What remains
; in the scene is the handful of things the simulation drives.

[ext_resource type="Script" path="res://scripts/presentation/slot_view_3d.gd" id="1_slotview"]

; Coins, not slabs: a small disc with its own emissive gold, so a payout reads
; as money in the air rather than as untextured debris.
[sub_resource type="StandardMaterial3D" id="Mat_coin"]
albedo_color = Color(0.98, 0.741, 0.302, 1)
metallic = 1.0
roughness = 0.28
emission_enabled = true
emission = Color(1, 0.678, 0.216, 1)
emission_energy_multiplier = 1.8
vertex_color_use_as_albedo = true

