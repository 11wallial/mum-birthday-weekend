[ext_resource type="PackedScene" path="res://scenes/3d/slot_machine_3d.tscn" id="3_machine"]
[ext_resource type="Script" path="res://scripts/presentation/camera_controller.gd" id="4_camera"]
[ext_resource type="PackedScene" path="res://scenes/ui/hud.tscn" id="5_hud"]
