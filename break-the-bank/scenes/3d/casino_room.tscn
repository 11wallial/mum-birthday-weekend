[ext_resource type="PackedScene" path="res://scenes/ui/touch_bar.tscn" id="10_touch"]
[ext_resource type="PackedScene" path="res://scenes/ui/film_overlay.tscn" id="11_film"]
[ext_resource type="PackedScene" path="res://scenes/ui/control_deck.tscn" id="12_deck"]
[ext_resource type="PackedScene" path="res://scenes/ui/contract_panel.tscn" id="13_contracts"]
