[gd_resource type="Resource" script_class="SoundDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/sound_def.gd" id="1_sounddef"]

[resource]
script = ExtResource("1_sounddef")
id = &"receipt_print"
file_name = "mechanical/receipt_print.wav"
category = 1
bus = &"SFX"
