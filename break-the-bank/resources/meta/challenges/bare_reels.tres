[gd_resource type="Resource" script_class="ChallengeDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/challenge_def.gd" id="1_challengedef"]

[resource]
script = ExtResource("1_challengedef")
id = &"bare_reels"
display_name = "Bare Reels"
description = "No holds and no nudges; three spins a floor and a tenth on every line in lieu. The basement never taught you, and the machine does not owe you a trail."
locked_systems = Array[StringName]([&"hold"])
spins_delta = 3
payout_scale = 1.1
