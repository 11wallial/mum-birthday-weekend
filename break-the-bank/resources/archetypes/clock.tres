[ext_resource type="Script" path="res://scripts/resources/archetype_def.gd" id="1_archetypedef"]

[resource]
script = ExtResource("1_archetypedef")
id = &"clock"
display_name = "The Clock"
brief = "Spins bought, spins refunded, and boilers that pay nothing until they light. The build that plays the floor's time as a resource."
