[gd_resource type="Resource" script_class="ArchetypeDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/archetype_def.gd" id="1_archetypedef"]

[resource]
script = ExtResource("1_archetypedef")
id = &"whale"
display_name = "The Whale"
brief = "Play at the top of the stake and let the hardware make the wager pay more than it costs. Win loudly, and pay to keep the room calm."
counter = "The spin costs the stake, and the count rises with what you win. The House sends someone over."
